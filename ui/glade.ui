<?xml version="1.0" encoding="UTF-8"?>
<!-- Converted for GTK4 compatibility (manual conversion from Glade/GTK3) -->
<interface>
  <requires lib="gtk" version="4.0"/>

  <!-- Main window -->
  <object class="GtkWindow" id="window1">
    <property name="can-focus">False</property>
    <property name="default-width">520</property>
    <property name="default-height">70</property>

    <!-- GTK4 uses 'child' property instead of <child> container packing of GTK3 -->
    <property name="child">
      <!-- GtkFixed is not available in GTK4; use GtkBox instead -->
      <object class="GtkBox" id="mainVBox">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">0</property>
        <property name="margin-bottom">0</property>

        <child>
          <object class="GtkBox" id="topRow">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>

            <child>
              <object class="GtkButton" id="scanNetworks">
                <property name="label" translatable="yes">Scan Networks</property>
                <signal name="clicked" handler="on_scanNetworks_clicked" swapped="no"/>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="setAP">
                <property name="label" translatable="yes">Set AP Mode</property>
                <signal name="clicked" handler="on_setAP_clicked" swapped="no"/>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="buttonConnect">
                <property name="label" translatable="yes">Connect</property>
                <signal name="clicked" handler="on_buttonConnect_clicked" swapped="no"/>
              </object>
            </child>

            <!-- Combo box replacement in GTK4: GtkDropDown -->
            <child>
              <object class="GtkDropDown" id="ssidStruct">
                <!-- Model will be set from code -->
                <signal name="notify::selected" handler="on_ssidStruct_selected_changed" swapped="no"/>
              </object>
            </child>

          </object>
        </child>

        <child>
          <object class="GtkLabel" id="monitor0">
            <property name="hexpand">True</property>
            <property name="halign">start</property>
            <property name="wrap">True</property>
            <property name="label" translatable="yes"></property>
          </object>
        </child>

      </object>
    </property>
  </object>

  <!-- Password dialog window (GTK4 does not have GtkDialog); use a modal transient GtkWindow -->
  <object class="GtkWindow" id="pwdDialog">
    <property name="title" translatable="yes">Password</property>
    <property name="modal">True</property>
    <property name="transient-for">window1</property>
    <property name="resizable">False</property>
    <property name="default-width">360</property>

    <property name="child">
      <object class="GtkBox" id="pwdDialogBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>

        <child>
          <object class="GtkEntry" id="textBox0">
            <property name="hexpand">True</property>
            <property name="placeholder-text" translatable="yes">Enter password</property>
            <!-- If this is truly a Wi-Fi password entry -->
            <property name="visibility">False</property>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="pwdButtonRow">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>

            <child>
              <object class="GtkButton" id="buttonCancel">
                <property name="label" translatable="yes">Cancel</property>
                <signal name="clicked" handler="on_buttonCancel_clicked" swapped="no"/>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="buttonOK">
                <property name="label" translatable="yes">OK</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="on_buttonOK_clicked" swapped="no"/>
              </object>
            </child>

          </object>
        </child>

      </object>
    </property>
  </object>
</interface>
